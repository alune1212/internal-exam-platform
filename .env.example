# internal-exam-platform Docker Compose 环境变量模板
# 使用方法：复制为 .env 后再填写；.env 含敏感信息，禁止提交到 Git。
# 当前默认值仅用于本机开发。正式内部考试应使用 ENVIRONMENT=internal，并替换所有示例口令与密钥。
# Compose 会自动为 backend 和 worker 设置 APP_ROLE，无需在本文件中配置。

# ==================== 运行环境与网络 ====================

# 运行环境：development=本机开发，internal=受控私有局域网，production=HTTPS 正式环境。
ENVIRONMENT=development

# Nginx 对外监听的主机 IP；开发可用 0.0.0.0，internal 必须填写部署主机的固定私网 IP。
INTERNAL_LAN_BIND_IP=0.0.0.0

# 允许访问 API 的前端来源，多个来源用英文逗号分隔；internal 必须精确匹配 http://<私网IP>:8080。
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ==================== PostgreSQL ====================

# PostgreSQL 用户 exam 的密码；正式环境必须替换为随机强密码。
POSTGRES_PASSWORD=local-dev-postgres-password

# 后端数据库连接地址；密码必须与 POSTGRES_PASSWORD 相同，特殊字符需进行 URL 编码。
DATABASE_URL=postgresql+psycopg://exam:local-dev-postgres-password@db:5432/internal_exam

# ==================== 管理员认证 ====================

# 初始管理员登录名。
ADMIN_USERNAME=admin

# 初始管理员登录密码；internal/production 禁止使用当前示例值。
ADMIN_PASSWORD=local-dev-admin-password

# 管理员及考试人 Token 的签名密钥；internal/production 必须使用足够长的随机字符串。
TOKEN_SECRET=local-dev-token-secret-change-before-production

# 登录 Token 有效期，单位为秒；43200 表示 12 小时。
TOKEN_TTL_SECONDS=43200

# 单个来源在限流窗口内最多可申请的公开 Token/验证码次数。
PUBLIC_TOKEN_RATE_LIMIT_COUNT=60

# 公开 Token/验证码接口的限流统计窗口，单位为秒。
PUBLIC_TOKEN_RATE_LIMIT_WINDOW_SECONDS=60

# 限流器最多保留的来源键数量，用于限制进程内存占用。
PUBLIC_TOKEN_RATE_LIMIT_MAX_KEYS=10000

# ==================== 考试人邮件验证码 ====================

# 邮件验证码有效期，单位为秒；不得小于 60。
CANDIDATE_LOGIN_OTP_TTL_SECONDS=600

# 单个验证码允许的最大校验失败次数，达到上限后验证码失效。
CANDIDATE_LOGIN_OTP_ATTEMPT_LIMIT=5

# 同一考试人再次申请验证码前的冷却时间，单位为秒。
CANDIDATE_LOGIN_OTP_RESEND_COOLDOWN_SECONDS=60

# 验证码投递方式：memory 仅供开发/测试，internal/production 必须使用 smtp。
CANDIDATE_LOGIN_EMAIL_DELIVERY_MODE=memory

# SMTP 临时失败时的最大投递尝试次数，允许范围为 1-10。
CANDIDATE_LOGIN_EMAIL_MAX_ATTEMPTS=3

# SMTP 重试的初始退避时间，单位为秒；后续重试按指数增长，允许范围为 0-30。
CANDIDATE_LOGIN_EMAIL_RETRY_BASE_SECONDS=1

# 验证码邮件发件人地址；smtp 模式必填，建议使用专用系统邮箱。
CANDIDATE_LOGIN_EMAIL_FROM=

# SMTP 服务器域名；smtp 模式必填，启用 SSL/TLS 时必须与服务器证书中的主机名匹配。
CANDIDATE_LOGIN_SMTP_HOST=

# SMTP 服务端口；STARTTLS 通常使用 587，请以邮件服务商说明为准。
CANDIDATE_LOGIN_SMTP_PORT=587

# SMTP 登录用户名；服务器不要求认证时可留空。
CANDIDATE_LOGIN_SMTP_USERNAME=

# SMTP 登录密码或应用专用密码；服务器不要求认证时可留空。
CANDIDATE_LOGIN_SMTP_PASSWORD=

# 是否在普通 SMTP 连接后启用 STARTTLS；端口 587 通常设为 true，不能与 USE_SSL 同时启用。
CANDIDATE_LOGIN_SMTP_USE_TLS=true

# 是否在连接建立时立即启用隐式 SSL；端口 465 或服务商指定的 994 通常设为 true。
CANDIDATE_LOGIN_SMTP_USE_SSL=false

# ==================== Excel 导入限制 ====================

# 单个 Excel 上传文件的最大字节数；5242880 表示 5 MiB。
IMPORT_MAX_UPLOAD_BYTES=5242880

# 单次 Excel 导入允许处理的最大数据行数。
IMPORT_MAX_ROWS=5000

# 单个导入工作簿允许包含的最大工作表数量。
IMPORT_MAX_SHEETS=1

# ==================== 学习视频存储与上传 ====================

# 后端容器内的学习视频持久化目录；Compose 已将该目录挂载到 named volume。
LEARNING_MEDIA_STORAGE_DIR=/app/learning-media

# 学习视频对外访问路径前缀，需与 Nginx 媒体路由保持一致。
LEARNING_MEDIA_PUBLIC_PATH=/media/learning

# 单个学习视频的最大上传字节数；524288000 表示 500 MiB。
LEARNING_VIDEO_MAX_UPLOAD_BYTES=524288000

# 允许上传的视频 MIME 类型，多个类型用英文逗号分隔。
LEARNING_VIDEO_ALLOWED_CONTENT_TYPES=video/mp4,video/webm

# ==================== 超时自动交卷 Worker ====================

# Worker 扫描超时考试的间隔，单位为秒。
AUTO_SUBMIT_CHECK_INTERVAL_SECONDS=30

# Worker 每轮最多处理的超时考试记录数量。
AUTO_SUBMIT_BATCH_SIZE=100

# Worker 在容器内写入健康心跳的文件路径，通常无需修改。
AUTO_SUBMIT_HEARTBEAT_PATH=/tmp/internal-exam-auto-submit.heartbeat

# 心跳允许的最大陈旧时间，单位为秒；必须大于或等于扫描间隔。
AUTO_SUBMIT_HEARTBEAT_MAX_AGE_SECONDS=90
