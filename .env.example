ENVIRONMENT=development
POSTGRES_PASSWORD=local-dev-postgres-password
DATABASE_URL=postgresql+psycopg://exam:local-dev-postgres-password@db:5432/internal_exam
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=local-dev-admin-password
TOKEN_SECRET=local-dev-token-secret-change-before-production
PUBLIC_TOKEN_RATE_LIMIT_MAX_KEYS=10000
CANDIDATE_LOGIN_OTP_TTL_SECONDS=600
CANDIDATE_LOGIN_OTP_ATTEMPT_LIMIT=5
CANDIDATE_LOGIN_OTP_RESEND_COOLDOWN_SECONDS=60
CANDIDATE_LOGIN_EMAIL_DELIVERY_MODE=memory
CANDIDATE_LOGIN_EMAIL_FROM=
CANDIDATE_LOGIN_SMTP_HOST=
CANDIDATE_LOGIN_SMTP_PORT=587
CANDIDATE_LOGIN_SMTP_USERNAME=
CANDIDATE_LOGIN_SMTP_PASSWORD=
CANDIDATE_LOGIN_SMTP_USE_TLS=true
IMPORT_MAX_UPLOAD_BYTES=5242880
IMPORT_MAX_ROWS=5000
IMPORT_MAX_SHEETS=1
LEARNING_MEDIA_STORAGE_DIR=/app/learning-media
LEARNING_MEDIA_PUBLIC_PATH=/media/learning
LEARNING_VIDEO_MAX_UPLOAD_BYTES=524288000
LEARNING_VIDEO_ALLOWED_CONTENT_TYPES=video/mp4,video/webm
