APP_NAME=internal-exam-platform
APP_VERSION=0.1.0
GIT_COMMIT=development
ENVIRONMENT=development
APP_ROLE=backend
INTERNAL_LAN_BIND_IP=0.0.0.0
DATABASE_URL=postgresql+psycopg://exam:local-dev-postgres-password@db:5432/internal_exam
# Production must restrict this to the deployed frontend/Nginx origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Current formal host is Apple Silicon macOS + Docker Desktop. In the protected
# formal environment, replace INTERNAL_LAN_BIND_IP and CORS_ORIGINS with the
# approved <FORMAL_LAN_IP> and http://<FORMAL_LAN_IP>:8080 only after its DHCP
# reservation and a pf rule allowing the approved CIDR to candidate TCP 8080.
# Historical or synthetic addresses must not be copied into formal settings.
# Operator TCP 8081 remains loopback.
# Docker Desktop runs after the designated host account signs in; creating a
# new operating-system account is not mandatory. Future Windows Docker Desktop
# with WSL2 hosts must re-verify these values.
ADMIN_USERNAME=admin
# Production must replace the default password and secret before migration.
ADMIN_PASSWORD=local-dev-admin-password
PRIMARY_OPERATOR_USERNAME=
PRIMARY_OPERATOR_PASSWORD=
BACKUP_OPERATOR_USERNAME=
BACKUP_OPERATOR_PASSWORD=
BACKUP_OPERATOR_ENABLED=false
TOKEN_SECRET=local-dev-token-secret-change-before-production
# Legacy development compatibility only.
TOKEN_TTL_SECONDS=43200
ADMIN_TOKEN_TTL_SECONDS=14400
CANDIDATE_TOKEN_TTL_SECONDS=14400
PUBLIC_TOKEN_RATE_LIMIT_COUNT=60
PUBLIC_TOKEN_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_TOKEN_RATE_LIMIT_MAX_KEYS=10000
CANDIDATE_LOGIN_OTP_TTL_SECONDS=600
CANDIDATE_LOGIN_OTP_ATTEMPT_LIMIT=5
CANDIDATE_LOGIN_OTP_RESEND_COOLDOWN_SECONDS=60
CANDIDATE_REGISTRATION_CREDENTIAL_TTL_SECONDS=600
CANDIDATE_LOGIN_EMAIL_RATE_LIMIT_COUNT=5
CANDIDATE_LOGIN_EMAIL_RATE_LIMIT_WINDOW_SECONDS=600
CANDIDATE_LOGIN_SOURCE_RATE_LIMIT_COUNT=30
CANDIDATE_LOGIN_SOURCE_RATE_LIMIT_WINDOW_SECONDS=600
CANDIDATE_LOGIN_GLOBAL_RATE_LIMIT_COUNT=10000
CANDIDATE_LOGIN_GLOBAL_RATE_LIMIT_WINDOW_SECONDS=86400
CANDIDATE_LOGIN_CLEANUP_BATCH_SIZE=100
CANDIDATE_LOGIN_CHALLENGE_RETENTION_SECONDS=86400
CANDIDATE_LOGIN_EMAIL_DELIVERY_MODE=memory
CANDIDATE_LOGIN_EMAIL_MAX_ATTEMPTS=3
CANDIDATE_LOGIN_EMAIL_RETRY_BASE_SECONDS=1
CANDIDATE_LOGIN_EMAIL_FROM=
# 启用 SSL/TLS 时必须使用与服务器证书匹配的 SMTP 域名。
CANDIDATE_LOGIN_SMTP_HOST=
CANDIDATE_LOGIN_SMTP_PORT=587
CANDIDATE_LOGIN_SMTP_USERNAME=
CANDIDATE_LOGIN_SMTP_PASSWORD=
CANDIDATE_LOGIN_SMTP_USE_TLS=true
CANDIDATE_LOGIN_SMTP_USE_SSL=false
# 候选端邀请入口只配置 origin；internal 必须使用固定私网 IP 的 :8080。
CANDIDATE_PUBLIC_BASE_URL=http://localhost:8080
INVITATION_SEND_BATCH_SIZE=200
INVITATION_CLAIM_TTL_SECONDS=300
INVITATION_ADMIN_RATE_LIMIT_COUNT=10
INVITATION_ADMIN_RATE_LIMIT_WINDOW_SECONDS=60
IMPORT_MAX_UPLOAD_BYTES=5242880
IMPORT_MAX_ROWS=5000
IMPORT_MAX_SHEETS=1
LEARNING_MEDIA_STORAGE_DIR=/app/learning-media
LEARNING_MEDIA_PUBLIC_PATH=/media/learning
LEARNING_VIDEO_MAX_UPLOAD_BYTES=524288000
LEARNING_VIDEO_ALLOWED_CONTENT_TYPES=video/mp4,video/webm
LIFECYCLE_ARCHIVE_DIR=/app/lifecycle/archives
BACKUP_STORAGE_DIR=/app/backups
OPERATIONS_EVIDENCE_DIR=/app/evidence
STORAGE_MIN_FREE_BYTES=21474836480
STORAGE_FOOTPRINT_MULTIPLIER=3
AUTO_SUBMIT_CHECK_INTERVAL_SECONDS=30
AUTO_SUBMIT_BATCH_SIZE=100
AUTO_SUBMIT_HEARTBEAT_PATH=/tmp/internal-exam-auto-submit.heartbeat
AUTO_SUBMIT_HEARTBEAT_MAX_AGE_SECONDS=90
# Production checklist: run a database backup before alembic upgrade head.
